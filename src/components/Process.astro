---
import T from './T.astro';

const steps = [
  {
    num: '01',
    title_en: 'A Living Starter',
    title_zh: '鮮活的酵種',
    body_en: 'It begins with our wild sourdough starter — flour and water, fed daily until it bubbles with natural yeast. No commercial yeast, ever.',
    body_zh: '一切始於我們的天然酵種——麵粉與水，每天餵養，直到冒出天然酵母的氣泡。絕不使用商業酵母。',
  },
  {
    num: '02',
    title_en: 'The Slow Rise',
    title_zh: '緩慢發酵',
    body_en: 'We mix, fold, and let the dough ferment slowly over 18–24 hours. Time is the real ingredient — it builds flavour and makes the bread easy to digest.',
    body_zh: '我們揉麵、折疊，讓麵團在 18 至 24 小時內緩慢發酵。時間才是真正的材料——它帶來風味，也讓麵包更好消化。',
  },
  {
    num: '03',
    title_en: 'Hand Shaped',
    title_zh: '手工塑形',
    body_en: 'Every loaf is shaped by hand and rested overnight in the cool, so the crumb sets open and airy and the tang deepens.',
    body_zh: '每一個麵包都由手工塑形，在低溫中靜置一夜，讓麵包心組織鬆軟通透，風味更加濃郁。',
  },
  {
    num: '04',
    title_en: 'Baked to Gold',
    title_zh: '烘至金黃',
    body_en: 'Scored and baked in a screaming-hot oven with steam for that signature crackly, deep-golden crust. Cooled, then straight to you.',
    body_zh: '劃紋後在高溫蒸氣烤箱中烘烤，成就標誌性的酥脆金黃外皮。冷卻後，隨即交到您手中。',
  },
];
---

<section id="how" class="bg-crust">
  <div class="container">
    <div class="story-head">
      <span class="eyebrow"><T en="How it's made" zh="製作工藝" /></span>
      <h2><T en="Bread the slow, honest way" zh="慢工細作，真材實料" /></h2>
      <p class="section-lead how-lead">
        <T
          en="Real sourdough can't be rushed. From a living starter to a golden crust, here's the journey every loaf takes before it reaches your table."
          zh="真正的酸種麵包急不得。從鮮活的酵種到金黃的外皮，每一個麵包在端上您的餐桌前，都要經歷這段旅程。"
        />
      </p>
    </div>

    <ol class="steps">
      {steps.map((s) => (
        <li class="step">
          <span class="step-num">{s.num}</span>
          <h3><T en={s.title_en} zh={s.title_zh} /></h3>
          <p><T en={s.body_en} zh={s.body_zh} /></p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .story-head { max-width: 720px; margin-bottom: 3rem; }
  .how-lead { color: rgba(250, 244, 234, 0.85); }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.5rem;
  }
  .step {
    background: rgba(250, 244, 234, 0.07);
    border: 1px solid rgba(250, 244, 234, 0.14);
    border-radius: var(--radius);
    padding: 1.8rem;
  }
  .step-num {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--wheat);
    display: block;
    margin-bottom: 0.6rem;
  }
  .step h3 { margin-bottom: 0.4rem; color: var(--cream); }
  .step p { margin: 0; color: rgba(250, 244, 234, 0.78); font-size: 0.98rem; }
</style>
