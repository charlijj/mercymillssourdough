---
import T from './T.astro';
---

<section id="top" class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <span class="eyebrow hero-eyebrow">
      <T en="Welcome to Mercy Mills" zh="歡迎來到 Mercy Mills" />
    </span>
    <h1>
      <T en="Handcrafted with Care, From My Home to Yours" zh="用心手作，從我家到您家" />
    </h1>
    <p class="hero-sub">
      <T
        en="I bake small-batch sourdough using a historic 150-year-old San Francisco starter, fresh-milled ancient grains, and pure, simple ingredients. In my certified home kitchen, I shape every loaf with patience to create bread that is naturally kind to your stomach — no shortcut additives or oils, just honest, living food baked warm for your table."
        zh="我以擁有 150 年歷史的舊金山酵種、現磨的古老穀物與純淨簡單的材料，小批量烘焙酸種麵包。在我通過認證的家庭廚房裡，我耐心地為每一個麵包塑形，做出天然溫和、不傷腸胃的麵包——沒有任何速成添加劑或油脂，只有誠實的、活的食物，溫暖地端上您的餐桌。"
      />
    </p>
    <div class="hero-actions">
      <a href="#order" class="btn btn-primary"><T en="Place an Order" zh="立即訂購" /></a>
      <a href="#menu" class="btn btn-outline hero-outline"><T en="See the Menu" zh="查看菜單" /></a>
    </div>
    <p class="hero-badge">
      <span class="badge-check" aria-hidden="true">✓</span>
      <T en="FOODSAFE Level 1 Certified · British Columbia" zh="FOODSAFE 一級認證 · 卑詩省（BC）" />
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    color: var(--cream);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(180deg, rgba(30, 20, 12, 0.62) 0%, rgba(30, 20, 12, 0.74) 100%),
      url('/images/hero-bread.jpg');
    background-size: cover;
    background-position: center;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 780px;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }
  .hero-eyebrow { color: var(--wheat); }
  .hero h1 { color: var(--cream); }
  .hero-sub {
    font-size: 1.1rem;
    color: rgba(250, 244, 234, 0.93);
    max-width: 660px;
    margin-bottom: 2rem;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .hero-outline { border-color: var(--cream); color: var(--cream); }
  .hero-outline:hover { background: var(--cream); color: var(--crust); }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.8rem 0 0;
    padding: 0.45rem 0.95rem;
    background: rgba(250, 244, 234, 0.12);
    border: 1px solid rgba(250, 244, 234, 0.3);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--cream);
  }
  .badge-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--sage);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 700;
  }
</style>
