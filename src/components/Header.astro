---
import { site } from '../data/menu.js';
import T from './T.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="#top" class="brand">
      <img src="/images/logo.png" class="brand-logo" alt={`${site.name} logo`} width="224" height="224" />
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <a href="#story"><T en="Our Story" zh="關於我們" /></a>
      <a href="#menu"><T en="Menu" zh="菜單" /></a>
      <a href="#newsletter"><T en="Newsletter" zh="訂閱" /></a>
      <button id="lang-toggle" class="lang-toggle" type="button" aria-label="切換語言 / Switch language">
        <span data-lang-en>中文</span><span data-lang-zh>EN</span>
      </button>
      <a href="#order" class="btn btn-primary nav-cta"><T en="Order Now" zh="立即訂購" /></a>
    </nav>
  </div>
</header>

<style>
  /* The header never collapses into a menu. Everything in it is sized from the
     window width with clamp(), so as the window narrows (or the browser is
     zoomed in, which narrows it in CSS pixels) the text shrinks to fit.

     Two layouts:
       - wide: brand and nav share one row.
       - narrow (<= 600px): brand on top, nav on a second row. The nav text keeps
         scaling with the width, so all five items always fit on that row. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 244, 234, 0.92);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid rgba(58, 42, 30, 0.08);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    column-gap: 1rem;
    row-gap: 0.15rem;
    min-height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(0.85rem, 2.1vw, 1.25rem);
    color: var(--crust);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .brand-logo { display: block; height: clamp(36px, 5.4vw, 54px); width: auto; flex-shrink: 0; }
  .brand:hover { text-decoration: none; color: var(--amber-deep); }

  /* Everything in the nav is in em, so one font-size scales the whole row. */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.35em;
    font-size: clamp(0.72rem, 1.5vw, 0.98rem);
    white-space: nowrap;
  }
  .site-nav a {
    color: var(--crust-soft);
    font-weight: 500;
  }
  .site-nav a:hover { color: var(--amber-deep); text-decoration: none; }

  .site-nav .lang-toggle { font-size: 0.92em; padding: 0.4em 0.9em; }
  .site-nav .nav-cta {
    color: var(--white);
    font-size: 1em;
    letter-spacing: 0.06em;
    padding: 0.55em 1.15em;
  }
  .site-nav .nav-cta:hover { color: var(--white); }

  @media (max-width: 600px) {
    .header-inner {
      justify-content: center;
      padding-top: 0.35rem;
      padding-bottom: 0.45rem;
      min-height: 0;
    }
    .brand { font-size: clamp(0.9rem, 4.2vw, 1.1rem); }
    .brand-logo { height: clamp(30px, 8vw, 38px); }

    /* The second row: spread the five items across the full width, sized so
       they always fit (about 3.2vw is 12.5px at 390px wide, 10.2px at 320px). */
    .site-nav {
      width: 100%;
      justify-content: space-between;
      gap: 0.6em;
      font-size: clamp(0.6rem, 3.15vw, 0.95rem);
    }
    .site-nav .nav-cta { padding: 0.5em 0.9em; letter-spacing: 0.03em; }
  }
</style>
