---
import T from './T.astro';
import PickupCalendar from './PickupCalendar.astro';
---

<section id="order" class="bg-cream-deep">
  <div class="container order-wrap">
    <div class="order-head">
      <span class="eyebrow"><T en="Place an order" zh="線上下單" /></span>
      <h2><T en="Order fresh sourdough" zh="訂購新鮮酸種麵包" /></h2>
      <p class="section-lead">
        <T
          en="Add your details and pickup date below. We'll email you back with your total and e-transfer details. Please order at least 3 days before your pickup date."
          zh="請在下方填寫您的資料與取貨日期。我們會以電子郵件回覆總金額與電子轉帳資訊。請至少在取貨日期前 3 天下單。"
        />
      </p>
    </div>

    <form id="order-form" class="order-form">
      <!-- Honeypot spam trap (leave empty) -->
      <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

      <!-- Quantities are chosen on the menu cards above; this is the summary
           of what was picked there, so nothing is listed twice. -->
      <fieldset class="fs-items">
        <legend><T en="Your order" zh="您的訂單" /></legend>
        <ul id="order-summary" class="order-summary">
          <li class="order-summary-empty">
            <T
              en="Nothing chosen yet — pick your quantities on the menu above."
              zh="尚未選擇商品——請在上方菜單選擇數量。"
            />
          </li>
        </ul>

        <div class="order-total">
          <span><T en="Total" zh="總計" /></span>
          <span id="order-total-amount">$0</span>
        </div>
      </fieldset>

      <div class="grid-2">
        <label class="field">
          <span><T en="Your name *" zh="您的姓名 *" /></span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label class="field">
          <span><T en="Email *" zh="電子郵件 *" /></span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
      </div>

      <div class="grid-2 grid-start">
        <label class="field">
          <span><T en="Phone" zh="電話" /></span>
          <input type="tel" name="phone" autocomplete="tel" />
        </label>
        <PickupCalendar />
      </div>

      <label class="field">
        <span><T en="Notes & preferred pickup location" zh="備註與希望取貨地點" /></span>
        <small class="field-note">
          <T
            en="Please be sure to provide your preferred pickup location, e.g. Fraser Heights Recreation Centre."
            zh="請務必提供您希望的取貨地點，例如 Fraser Heights Recreation Centre。"
          />
        </small>
        <textarea
          name="notes"
          rows="3"
          data-ph-en="Preferred pickup location, e.g. Fraser Heights Recreation Centre — plus any allergy concerns or special requests."
          data-ph-zh="希望的取貨地點，例如 Fraser Heights Recreation Centre——以及任何過敏事項或特殊需求。"
          placeholder="Preferred pickup location, e.g. Fraser Heights Recreation Centre — plus any allergy concerns or special requests."
        ></textarea>
        <small class="field-hint">
          <T
            en="Have allergies? Our breads may contain wheat, gluten, and eggs — list any concerns above so we can help."
            zh="有過敏情況嗎？我們的麵包可能含有小麥、麩質與雞蛋——請在上方列出任何顧慮，以便我們協助。"
          />
        </small>
      </label>

      <div class="pickup-note">
        <p>
          <strong><T en="Pickup only." zh="僅限自取。" /></strong>
          <T en="We'll confirm the pickup address and time with you by email." zh="我們將以電子郵件與您確認取貨地址與時間。" />
        </p>
        <p>
          <strong><T en="Payment: e-transfer only." zh="付款方式：僅接受電子轉帳。" /></strong>
          <T
            en="Your order is confirmed only once your e-transfer has been received."
            zh="我們收到您的電子轉帳後，訂單才算確認。"
          />
        </p>
      </div>

      <button type="submit" class="btn btn-primary order-submit">
        <T en="Send Order Request" zh="送出訂單需求" />
      </button>

      <p id="order-status" class="order-status" role="status" aria-live="polite"></p>
      <p class="order-fineprint">
        <T
          en="This sends a request, not a payment. We'll reply with your total and e-transfer details."
          zh="這是送出訂單需求，並非付款。我們會回覆您的總金額與電子轉帳資訊。"
        />
      </p>
    </form>
  </div>
</section>

<style>
  .order-wrap { max-width: 820px; }
  .order-head { margin-bottom: 2.5rem; }
  .order-form {
    background: var(--white);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2.6rem);
    box-shadow: var(--shadow);
    border: 1px solid rgba(58, 42, 30, 0.06);
  }
  fieldset { border: none; padding: 0; margin: 0 0 1.6rem; }
  legend {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--crust);
    padding: 0;
    margin-bottom: 0.9rem;
  }
  .order-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    background: var(--crust);
    color: var(--cream);
    border-radius: 10px;
    font-weight: 600;
  }
  #order-total-amount {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--wheat);
  }
  .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 1.6rem 0;
  }
  .grid-start { align-items: start; }
  .field { display: flex; flex-direction: column; gap: 0.35rem; }
  .field > span { font-weight: 500; font-size: 0.92rem; color: var(--crust-soft); }
  .field-hint { color: var(--muted); font-size: 0.8rem; }
  /* Sits above the notes box, as the owner asked */
  .field-note {
    color: var(--crust-soft);
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  input, textarea, select {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.7rem 0.85rem;
    border: 1.5px solid rgba(58, 42, 30, 0.15);
    border-radius: 9px;
    background: var(--white);
    color: var(--ink);
    width: 100%;
  }
  input:focus, textarea:focus, select:focus {
    outline: none;
    border-color: var(--amber);
    box-shadow: 0 0 0 3px rgba(200, 134, 45, 0.15);
  }
  .pickup-note {
    font-size: 0.9rem;
    color: var(--crust-soft);
    background: var(--cream);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    margin: 0 0 1.4rem;
  }
  .pickup-note p { margin: 0 0 0.4rem; }
  .pickup-note p:last-child { margin: 0; }
  .order-submit { width: 100%; margin-top: 0.25rem; font-size: 1.05rem; }
  .order-status { margin: 1rem 0 0; font-weight: 600; text-align: center; }
  .order-status.ok { color: var(--olive-deep); }
  .order-status.err { color: #b23b2e; }
  .order-fineprint { font-size: 0.85rem; color: var(--muted); text-align: center; margin: 0.8rem 0 0; }

  @media (max-width: 620px) {
    .grid-2 { grid-template-columns: 1fr; }
  }
</style>

<!-- The summary rows are built by JavaScript, so they never receive Astro's
     scoping attribute and scoped rules would not reach them. These are global,
     namespaced under #order-summary so nothing else is affected. -->
<style is:global>
  #order-summary { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  #order-summary .order-summary-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0.9rem;
    background: var(--cream);
    border-radius: 10px;
    border: 1px solid rgba(58, 42, 30, 0.06);
  }
  #order-summary .summary-name { font-weight: 600; color: var(--crust); }
  #order-summary .summary-name small { font-weight: 400; color: var(--muted); }
  #order-summary .summary-amount {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--amber-deep);
    white-space: nowrap;
  }
  #order-summary .order-summary-empty {
    padding: 0.9rem;
    color: var(--muted);
    font-size: 0.95rem;
    text-align: center;
  }
</style>

<script>
  const form = document.getElementById('order-form');
  const status = document.getElementById('order-status');
  const totalAmount = document.getElementById('order-total-amount');
  const dateInput = document.getElementById('pickup-date');

  const ORDER_API = (import.meta.env.PUBLIC_ORDER_API || '').replace(/\/$/, '');

  const msg = {
    none: { en: 'Please choose a quantity for at least one item.', zh: '請至少為一項商品選擇數量。' },
    date: { en: 'Please choose a pickup date from the calendar.', zh: '請從日曆中選擇取貨日期。' },
    noapi: { en: 'Ordering is not available right now. Please email us and we’ll help.', zh: '目前無法下單，請寄電子郵件給我們，我們會協助您。' },
    sending: { en: 'Sending your order…', zh: '正在送出您的訂單……' },
    ok: {
      en: 'Thank you! Your order request was sent. We’ll email you to confirm.',
      zh: '謝謝！您的訂單需求已送出。我們會以電子郵件與您確認。',
    },
    err: {
      en: 'Sorry, something went wrong. Please email us directly and we’ll sort it out.',
      zh: '抱歉，發生問題。請直接寄電子郵件給我們，我們會為您處理。',
    },
  };
  const lang = () => (document.documentElement.getAttribute('data-lang') === 'zh' ? 'zh' : 'en');
  const fmt = (n) => (Number.isInteger(n) ? `$${n}` : `$${n.toFixed(2)}`);

  // The quantity controls live on the menu cards above this form, so look them
  // up across the document rather than inside the form element.
  const rows = Array.from(document.querySelectorAll('.item-row'));
  const summary = document.getElementById('order-summary');
  const menuTotal = document.getElementById('menu-total-amount');

  // Unit price for a row: the selected size's price, or the item's flat price.
  function unitPrice(row) {
    const size = row.querySelector('select[data-role="size"]');
    if (size) return Number(size.selectedOptions[0].dataset.price) || 0;
    return Number(row.dataset.price) || 0;
  }

  function refreshRow(row) {
    const el = row.querySelector('.unit-price');
    if (el) el.textContent = fmt(unitPrice(row));
  }

  function rowQty(row) {
    return Number(row.querySelector('select[data-role="qty"]').value) || 0;
  }

  function recalcTotal() {
    let t = 0;
    rows.forEach((row) => {
      t += rowQty(row) * unitPrice(row);
    });
    if (totalAmount) totalAmount.textContent = fmt(t);
    if (menuTotal) menuTotal.textContent = fmt(t);
    return t;
  }

  // Mirror the chosen items into the form so the customer can check their
  // order without scrolling back up through the menu.
  function renderSummary() {
    if (!summary) return;
    const chosen = rows.filter(rowQty);
    summary.textContent = '';

    if (!chosen.length) {
      const li = document.createElement('li');
      li.className = 'order-summary-empty';
      li.textContent =
        lang() === 'zh'
          ? '尚未選擇商品——請在上方菜單選擇數量。'
          : 'Nothing chosen yet — pick your quantities on the menu above.';
      summary.appendChild(li);
      return;
    }

    chosen.forEach((row) => {
      const qty = rowQty(row);
      const titleEl = row.querySelector('.title-button');
      const name = titleEl ? titleEl.innerText.trim() : row.dataset.name;

      // Read the label from the data attributes rather than the rendered text,
      // so this does not depend on the option translator having run first.
      const optText = (opt) =>
        (lang() === 'zh' && opt.dataset.labelZh) || opt.dataset.label || opt.textContent.trim();

      const bits = [];
      const size = row.querySelector('select[data-role="size"]');
      if (size) bits.push(optText(size.selectedOptions[0]));
      row.querySelectorAll('select[data-role="option"]').forEach((sel) => {
        bits.push(optText(sel.selectedOptions[0]));
      });

      const li = document.createElement('li');
      li.className = 'order-summary-row';

      const label = document.createElement('span');
      label.className = 'summary-name';
      label.textContent = `${qty} × ${name}`;
      if (bits.length) {
        const meta = document.createElement('small');
        meta.textContent = ` (${bits.join(', ')})`;
        label.appendChild(meta);
      }

      const amount = document.createElement('span');
      amount.className = 'summary-amount';
      amount.textContent = fmt(qty * unitPrice(row));

      li.append(label, amount);
      summary.appendChild(li);
    });
  }

  function refreshAll() {
    recalcTotal();
    renderSummary();
  }

  rows.forEach((row) => {
    row.querySelectorAll('select').forEach((sel) =>
      sel.addEventListener('change', () => {
        refreshRow(row);
        row.classList.toggle('has-qty', rowQty(row) > 0);
        refreshAll();
      })
    );
  });

  // The detail popup's "Add one to my order" button.
  document.querySelectorAll('[data-add-for]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const row = rows.find((r) => r.dataset.id === btn.dataset.addFor);
      if (!row) return;
      const qty = row.querySelector('select[data-role="qty"]');
      qty.value = String(Math.min(Number(qty.value || 0) + 1, qty.options.length - 1));
      row.classList.toggle('has-qty', rowQty(row) > 0);
      refreshAll();
    });
  });

  // Quantities and the summary are language-independent except for the labels,
  // so re-render when the visitor switches language.
  new MutationObserver(renderSummary).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-lang'],
  });

  function buildOrder() {
    const items = rows
      .map((row) => {
        const qty = rowQty(row);
        if (qty <= 0) return null;
        const size = row.querySelector('select[data-role="size"]');
        const options = {};
        row.querySelectorAll('select[data-role="option"]').forEach((sel) => {
          options[sel.dataset.optLabel] = sel.selectedOptions[0].dataset.label;
        });
        return {
          id: row.dataset.id,
          name: row.dataset.name,
          unit: size ? size.selectedOptions[0].dataset.label : '',
          size: size ? size.selectedOptions[0].dataset.label : '',
          options,
          price: unitPrice(row),
          qty,
        };
      })
      .filter(Boolean);

    return {
      items,
      total: recalcTotal(),
      lang: lang(),
      pickupDate: form.querySelector('[name="preferred_date"]').value,
      notes: form.querySelector('[name="notes"]').value,
      botcheck: form.querySelector('[name="botcheck"]').checked,
      customer: {
        name: form.querySelector('[name="name"]').value.trim(),
        email: form.querySelector('[name="email"]').value.trim(),
        phone: form.querySelector('[name="phone"]').value.trim(),
      },
    };
  }

  if (form && status) {
    rows.forEach(refreshRow);
    refreshAll();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (recalcTotal() === 0) {
        status.textContent = msg.none[lang()];
        status.className = 'order-status err';
        return;
      }
      if (dateInput && !dateInput.value) {
        status.textContent = msg.date[lang()];
        status.className = 'order-status err';
        return;
      }
      if (!ORDER_API) {
        status.textContent = msg.noapi[lang()];
        status.className = 'order-status err';
        return;
      }

      status.textContent = msg.sending[lang()];
      status.className = 'order-status';

      try {
        const res = await fetch(ORDER_API + '/api/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(buildOrder()),
        });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.success) throw new Error(j.error || 'Submission failed');
        status.textContent = msg.ok[lang()];
        status.className = 'order-status ok';
        form.reset();
        rows.forEach(refreshRow);
        recalcTotal();
      } catch (err) {
        status.textContent = msg.err[lang()];
        status.className = 'order-status err';
      }
    });
  }
</script>
