---
import { menu } from '../data/menu.js';
import T from './T.astro';
import PickupCalendar from './PickupCalendar.astro';

const quantities = [0, 1, 2, 3, 4, 5];
const fmt = (n) => (Number.isInteger(n) ? `$${n}` : `$${n.toFixed(2)}`);
---

<section id="order">
  <div class="container order-wrap">
    <div class="order-head">
      <span class="eyebrow"><T en="Place an order" zh="線上下單" /></span>
      <h2><T en="Order fresh sourdough" zh="訂購新鮮酸種麵包" /></h2>
      <p class="section-lead">
        <T
          en="Tell us what you'd like and when. We'll email you back with your total and e-transfer details. Please order at least 3 days before your pickup date."
          zh="告訴我們您想要什麼、何時取貨。我們會以電子郵件回覆總金額與電子轉帳資訊。請至少在取貨日期前 3 天下單。"
        />
      </p>
    </div>

    <form id="order-form" class="order-form">
      <!-- Honeypot spam trap (leave empty) -->
      <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

      <fieldset class="fs-items">
        <legend><T en="What would you like?" zh="您想要點什麼？" /></legend>
        <div class="item-list">
          {menu.map((item) => (
            <div class="item-row" data-id={item.id} data-name={item.name} data-price={item.price ?? ''}>
              <img class="item-thumb" src={item.image} alt="" loading="lazy" />

              <div class="item-main">
                <span class="item-title"><T en={item.name} zh={item.name_zh} /></span>
                <small class="item-price">
                  <span class="unit-price">
                    {item.sizes ? fmt(item.sizes[0].price) : fmt(item.price)}
                  </span>
                  {!item.sizes && (
                    <> / <T en={item.unit} zh={item.unit_zh} /></>
                  )}
                </small>

                {(item.sizes || item.options) && (
                  <div class="item-opts">
                    {item.sizes && (
                      <label class="opt">
                        <span class="opt-label"><T en="Size" zh="份量" /></span>
                        <select data-role="size" aria-label={`Size for ${item.name}`}>
                          {item.sizes.map((s) => (
                            <option value={s.id} data-price={s.price} data-label={s.label}>
                              {s.label}
                            </option>
                          ))}
                        </select>
                      </label>
                    )}
                    {item.options && item.options.map((opt) => (
                      <label class="opt">
                        <span class="opt-label"><T en={opt.label} zh={opt.label_zh} /></span>
                        <select
                          data-role="option"
                          data-opt-id={opt.id}
                          data-opt-label={opt.label}
                          aria-label={`${opt.label} for ${item.name}`}
                        >
                          {opt.choices.map((c) => (
                            <option value={c.id} data-label={c.label}>{c.label}</option>
                          ))}
                        </select>
                      </label>
                    ))}
                  </div>
                )}
              </div>

              <select data-role="qty" aria-label={`Quantity of ${item.name}`}>
                {quantities.map((q) => <option value={q}>{q}</option>)}
              </select>
            </div>
          ))}
        </div>

        <div class="order-total">
          <span><T en="Total" zh="總計" /></span>
          <span id="order-total-amount">$0</span>
        </div>
      </fieldset>

      <div class="grid-2">
        <label class="field">
          <span><T en="Your name *" zh="您的姓名 *" /></span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label class="field">
          <span><T en="Email *" zh="電子郵件 *" /></span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
      </div>

      <div class="grid-2 grid-start">
        <label class="field">
          <span><T en="Phone" zh="電話" /></span>
          <input type="tel" name="phone" autocomplete="tel" />
        </label>
        <PickupCalendar />
      </div>

      <label class="field">
        <span><T en="Notes & allergy concerns" zh="備註與過敏事項" /></span>
        <textarea
          name="notes"
          rows="3"
          data-ph-en="Please note any allergy concerns or special requests here."
          data-ph-zh="請在此註明任何過敏事項或特殊需求。"
          placeholder="Please note any allergy concerns or special requests here."
        ></textarea>
        <small class="field-hint">
          <T
            en="Have allergies? Our breads may contain wheat, gluten, and eggs. Please list any concerns above so we can help."
            zh="有過敏情況嗎？我們的麵包可能含有小麥、麩質與雞蛋。請在上方列出任何顧慮，以便我們協助。"
          />
        </small>
      </label>

      <div class="pickup-note">
        <p>
          <strong><T en="Pickup only." zh="僅限自取。" /></strong>
          <T en="We'll confirm the pickup address and time with you by email." zh="我們將以電子郵件與您確認取貨地址與時間。" />
        </p>
        <p>
          <strong><T en="Payment: e-transfer only." zh="付款方式：僅接受電子轉帳。" /></strong>
          <T
            en="Your order is confirmed only once your e-transfer has been received."
            zh="我們收到您的電子轉帳後，訂單才算確認。"
          />
        </p>
      </div>

      <button type="submit" class="btn btn-primary order-submit">
        <T en="Send Order Request" zh="送出訂單需求" />
      </button>

      <p id="order-status" class="order-status" role="status" aria-live="polite"></p>
      <p class="order-fineprint">
        <T
          en="This sends a request, not a payment. We'll reply with your total and e-transfer details."
          zh="這是送出訂單需求，並非付款。我們會回覆您的總金額與電子轉帳資訊。"
        />
      </p>
    </form>
  </div>
</section>

<style>
  .order-wrap { max-width: 820px; }
  .order-head { margin-bottom: 2.5rem; }
  .order-form {
    background: var(--white);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2.6rem);
    box-shadow: var(--shadow);
    border: 1px solid rgba(58, 42, 30, 0.06);
  }
  fieldset { border: none; padding: 0; margin: 0 0 1.6rem; }
  legend {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--crust);
    padding: 0;
    margin-bottom: 0.9rem;
  }
  .item-list { display: grid; gap: 0.6rem; }
  .item-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 0.9rem;
    background: var(--cream);
    border-radius: 10px;
    border: 1px solid rgba(58, 42, 30, 0.06);
  }
  .item-thumb {
    width: 54px; height: 54px;
    border-radius: 8px;
    object-fit: cover;
    background: var(--cream-deep);
    flex-shrink: 0;
  }
  .item-main { display: flex; flex-direction: column; flex: 1; min-width: 0; gap: 0.15rem; }
  .item-title { font-weight: 600; }
  .item-price { color: var(--muted); font-size: 0.85rem; }
  .item-opts { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.35rem; }
  .opt { display: flex; align-items: center; gap: 0.35rem; }
  .opt-label { font-size: 0.78rem; color: var(--muted); }
  .item-opts select {
    width: auto;
    font-size: 0.85rem;
    padding: 0.3rem 0.5rem;
    border-radius: 7px;
  }
  .item-row > select[data-role='qty'] {
    width: 78px;
    text-align: center;
    padding: 0.55rem 0.6rem;
    cursor: pointer;
    flex-shrink: 0;
  }
  .order-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    background: var(--crust);
    color: var(--cream);
    border-radius: 10px;
    font-weight: 600;
  }
  #order-total-amount {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--wheat);
  }
  .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 1.6rem 0;
  }
  .grid-start { align-items: start; }
  .field { display: flex; flex-direction: column; gap: 0.35rem; }
  .field > span { font-weight: 500; font-size: 0.92rem; color: var(--crust-soft); }
  .field-hint { color: var(--muted); font-size: 0.8rem; }
  input, textarea, select {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.7rem 0.85rem;
    border: 1.5px solid rgba(58, 42, 30, 0.15);
    border-radius: 9px;
    background: var(--white);
    color: var(--ink);
    width: 100%;
  }
  input:focus, textarea:focus, select:focus {
    outline: none;
    border-color: var(--amber);
    box-shadow: 0 0 0 3px rgba(200, 134, 45, 0.15);
  }
  .pickup-note {
    font-size: 0.9rem;
    color: var(--crust-soft);
    background: var(--cream);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    margin: 0 0 1.4rem;
  }
  .pickup-note p { margin: 0 0 0.4rem; }
  .pickup-note p:last-child { margin: 0; }
  .order-submit { width: 100%; margin-top: 0.25rem; font-size: 1.05rem; }
  .order-status { margin: 1rem 0 0; font-weight: 600; text-align: center; }
  .order-status.ok { color: var(--sage-deep); }
  .order-status.err { color: #b23b2e; }
  .order-fineprint { font-size: 0.85rem; color: var(--muted); text-align: center; margin: 0.8rem 0 0; }

  @media (max-width: 620px) {
    .grid-2 { grid-template-columns: 1fr; }
    .item-row { flex-wrap: wrap; }
    .item-main { flex-basis: calc(100% - 150px); }
  }
</style>

<script>
  const form = document.getElementById('order-form');
  const status = document.getElementById('order-status');
  const totalAmount = document.getElementById('order-total-amount');
  const dateInput = document.getElementById('pickup-date');

  const ORDER_API = (import.meta.env.PUBLIC_ORDER_API || '').replace(/\/$/, '');

  const msg = {
    none: { en: 'Please choose a quantity for at least one item.', zh: '請至少為一項商品選擇數量。' },
    date: { en: 'Please choose a pickup date from the calendar.', zh: '請從日曆中選擇取貨日期。' },
    noapi: { en: 'Ordering is not available right now. Please email us and we’ll help.', zh: '目前無法下單，請寄電子郵件給我們，我們會協助您。' },
    sending: { en: 'Sending your order…', zh: '正在送出您的訂單……' },
    ok: {
      en: 'Thank you! Your order request was sent. We’ll email you to confirm.',
      zh: '謝謝！您的訂單需求已送出。我們會以電子郵件與您確認。',
    },
    err: {
      en: 'Sorry, something went wrong. Please email us directly and we’ll sort it out.',
      zh: '抱歉，發生問題。請直接寄電子郵件給我們，我們會為您處理。',
    },
  };
  const lang = () => (document.documentElement.getAttribute('data-lang') === 'zh' ? 'zh' : 'en');
  const fmt = (n) => (Number.isInteger(n) ? `$${n}` : `$${n.toFixed(2)}`);

  const rows = form ? Array.from(form.querySelectorAll('.item-row')) : [];

  // Unit price for a row: the selected size's price, or the item's flat price.
  function unitPrice(row) {
    const size = row.querySelector('select[data-role="size"]');
    if (size) return Number(size.selectedOptions[0].dataset.price) || 0;
    return Number(row.dataset.price) || 0;
  }

  function refreshRow(row) {
    const el = row.querySelector('.unit-price');
    if (el) el.textContent = fmt(unitPrice(row));
  }

  function recalcTotal() {
    let t = 0;
    rows.forEach((row) => {
      const qty = Number(row.querySelector('select[data-role="qty"]').value) || 0;
      t += qty * unitPrice(row);
    });
    if (totalAmount) totalAmount.textContent = fmt(t);
    return t;
  }

  rows.forEach((row) => {
    row.querySelectorAll('select').forEach((sel) =>
      sel.addEventListener('change', () => {
        refreshRow(row);
        recalcTotal();
      })
    );
  });

  function buildOrder() {
    const items = rows
      .map((row) => {
        const qty = Number(row.querySelector('select[data-role="qty"]').value) || 0;
        if (qty <= 0) return null;
        const size = row.querySelector('select[data-role="size"]');
        const options = {};
        row.querySelectorAll('select[data-role="option"]').forEach((sel) => {
          options[sel.dataset.optLabel] = sel.selectedOptions[0].dataset.label;
        });
        return {
          id: row.dataset.id,
          name: row.dataset.name,
          unit: size ? size.selectedOptions[0].dataset.label : '',
          size: size ? size.selectedOptions[0].dataset.label : '',
          options,
          price: unitPrice(row),
          qty,
        };
      })
      .filter(Boolean);

    return {
      items,
      total: recalcTotal(),
      lang: lang(),
      pickupDate: form.querySelector('[name="preferred_date"]').value,
      notes: form.querySelector('[name="notes"]').value,
      botcheck: form.querySelector('[name="botcheck"]').checked,
      customer: {
        name: form.querySelector('[name="name"]').value.trim(),
        email: form.querySelector('[name="email"]').value.trim(),
        phone: form.querySelector('[name="phone"]').value.trim(),
      },
    };
  }

  if (form && status) {
    rows.forEach(refreshRow);
    recalcTotal();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (recalcTotal() === 0) {
        status.textContent = msg.none[lang()];
        status.className = 'order-status err';
        return;
      }
      if (dateInput && !dateInput.value) {
        status.textContent = msg.date[lang()];
        status.className = 'order-status err';
        return;
      }
      if (!ORDER_API) {
        status.textContent = msg.noapi[lang()];
        status.className = 'order-status err';
        return;
      }

      status.textContent = msg.sending[lang()];
      status.className = 'order-status';

      try {
        const res = await fetch(ORDER_API + '/api/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(buildOrder()),
        });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.success) throw new Error(j.error || 'Submission failed');
        status.textContent = msg.ok[lang()];
        status.className = 'order-status ok';
        form.reset();
        rows.forEach(refreshRow);
        recalcTotal();
      } catch (err) {
        status.textContent = msg.err[lang()];
        status.className = 'order-status err';
      }
    });
  }
</script>
