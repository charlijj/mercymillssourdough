---
import { menu } from '../data/menu.js';
import T from './T.astro';

const fmt = (n) => (Number.isInteger(n) ? `$${n}` : `$${n.toFixed(2)}`);
const quantities = [0, 1, 2, 3, 4, 5];

// Chinese labels for the short product tags.
const tagZh = { Bestseller: '熱銷', Seasonal: '季節限定', Sweet: '甜點' };
---

<section id="menu">
  <div class="container">
    <div class="menu-head">
      <span class="eyebrow"><T en="The Menu" zh="菜單" /></span>
      <h2><T en="Our breads & bakes" zh="麵包與烘焙" /></h2>
      <p class="section-lead">
        <T
          en="Everything is baked to order in small batches. Choose your quantities here, then add your details below to finish your order for local pickup."
          zh="所有產品皆為小批量接單製作。請在此選擇數量，再於下方填寫您的資料完成訂購，到店自取。"
        />
      </p>
    </div>

    <div class="menu-search">
      <input
        type="search"
        id="menu-search"
        autocomplete="off"
        aria-label="Search the menu"
        data-ph-en="Search the menu…"
        data-ph-zh="搜尋菜單……"
        placeholder="Search the menu…"
      />
    </div>

    <p id="menu-no-results" class="menu-no-results" hidden>
      <T en="No items match your search." zh="沒有找到符合的商品。" />
    </p>

    <div class="menu-grid">
      {menu.map((item) => (
        <article
          class="card item-row"
          data-id={item.id}
          data-name={item.name}
          data-price={item.price ?? ''}
          data-search={`${item.name} ${item.name_zh} ${item.description} ${item.description_zh}`.toLowerCase()}
        >
          <button
            type="button"
            class="card-media"
            data-detail-for={item.id}
            aria-label={`View details for ${item.name}`}
          >
            <img src={item.image} alt={item.name} loading="lazy" />
            {item.tags && item.tags.length > 0 && (
              <span class="card-tag">
                <T en={item.tags[0]} zh={tagZh[item.tags[0]] || item.tags[0]} />
              </span>
            )}
          </button>
          <div class="card-body">
            <div class="card-title-row">
              <h3>
                <button type="button" class="title-button" data-detail-for={item.id}>
                  <T en={item.name} zh={item.name_zh} />
                </button>
              </h3>
              <span class="card-price">
                <span class="unit-price">
                  {item.sizes ? fmt(item.sizes[0].price) : fmt(item.price)}
                </span>
                {!item.sizes && (
                  <small>/<T en={item.unit} zh={item.unit_zh} /></small>
                )}
              </span>
            </div>
            <p><T en={item.description} zh={item.description_zh} /></p>

            <button type="button" class="card-details-link" data-detail-for={item.id}>
              <T en="Ingredients & details →" zh="成分與詳細資訊 →" />
            </button>

            {/* Order controls live on the card itself, so customers choose
                quantities while browsing instead of in a second list below. */}
            <div class="card-order">
              {item.sizes && (
                <label class="opt">
                  <span class="opt-label"><T en="Size" zh="份量" /></span>
                  <select data-role="size" aria-label={`Size for ${item.name}`}>
                    {item.sizes.map((s) => (
                      <option
                        value={s.id}
                        data-price={s.price}
                        data-label={s.label}
                        data-label-zh={s.label_zh || s.label}
                      >
                        {s.label}
                      </option>
                    ))}
                  </select>
                </label>
              )}
              {item.options && item.options.map((opt) => (
                <label class="opt">
                  <span class="opt-label"><T en={opt.label} zh={opt.label_zh} /></span>
                  <select
                    data-role="option"
                    data-opt-id={opt.id}
                    data-opt-label={opt.label}
                    aria-label={`${opt.label} for ${item.name}`}
                  >
                    {opt.choices.map((c) => (
                      <option value={c.id} data-label={c.label} data-label-zh={c.label_zh || c.label}>
                        {c.label}
                      </option>
                    ))}
                  </select>
                </label>
              ))}
              <label class="opt opt-qty">
                <span class="opt-label"><T en="Quantity" zh="數量" /></span>
                <select data-role="qty" aria-label={`Quantity of ${item.name}`}>
                  {quantities.map((q) => <option value={q}>{q}</option>)}
                </select>
              </label>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="text-center menu-cta">
      <p class="menu-running-total">
        <T en="Your order so far:" zh="目前您的訂單：" />
        <strong id="menu-total-amount">$0</strong>
      </p>
      <a href="#order" class="btn btn-primary">
        <T en="Continue to your details →" zh="繼續填寫您的資料 →" />
      </a>
    </div>
  </div>

  <!-- Product detail popup. One panel per product; JS shows the matching one. -->
  <div id="product-modal" class="modal" aria-hidden="true">
    <div class="modal-backdrop" data-close></div>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-heading">
      <button type="button" class="modal-close" data-close aria-label="Close">×</button>
      <h3 id="modal-heading" class="visually-hidden">Product details</h3>
      {menu.map((item) => (
        <div class="modal-panel" data-panel={item.id} hidden>
          <img class="modal-img" src={item.image} alt={item.name} />
          <h4 class="modal-title"><T en={item.name} zh={item.name_zh} /></h4>
          <p class="modal-price">
            {item.sizes
              ? item.sizes.map((s, i) => <>{i > 0 && ' · '}{fmt(s.price)}<small>/{s.id}</small></>)
              : <>{fmt(item.price)}<small>/<T en={item.unit} zh={item.unit_zh} /></small></>}
          </p>

          <p class="modal-about">
            <T
              en={item.details?.about || item.description}
              zh={item.details?.about_zh || item.description_zh}
            />
          </p>

          <dl class="modal-facts">
            <dt><T en="Ingredients" zh="成分" /></dt>
            <dd>
              {item.details?.ingredients
                ? <T en={item.details.ingredients} zh={item.details.ingredients_zh || item.details.ingredients} />
                : <span class="soon"><T en="Full ingredient list coming soon." zh="完整成分表即將公佈。" /></span>}
            </dd>

            {item.details?.netWeight && (
              <>
                <dt><T en="Net weight" zh="淨重" /></dt>
                <dd>{item.details.netWeight}</dd>
              </>
            )}
          </dl>

          <button type="button" class="btn btn-primary modal-order" data-add-for={item.id} data-close>
            <T en="Add one to my order" zh="加入一件到訂單" />
          </button>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .menu-head { max-width: 720px; margin-bottom: 2rem; }
  .menu-search { max-width: 420px; margin: 0 0 2.2rem; }
  .menu-search input {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.75rem 1.1rem;
    border: 1.5px solid rgba(58, 42, 30, 0.15);
    border-radius: 999px;
    background: var(--white);
    color: var(--ink);
  }
  .menu-search input:focus {
    outline: none;
    border-color: var(--amber);
    box-shadow: 0 0 0 3px rgba(200, 134, 45, 0.15);
  }
  .menu-no-results { color: var(--muted); font-weight: 500; margin: 0 0 1.5rem; }
  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.8rem;
  }
  .card {
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(58, 42, 30, 0.06);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    display: flex;
    flex-direction: column;
  }
  .card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .card[hidden] { display: none; }
  .card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--cream-deep);
    overflow: hidden;
  }
  /* Absolutely positioned so portrait photos are cropped to the 4:3 box and
     every card keeps the same image height. */
  .card-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-tag {
    position: absolute;
    top: 0.9rem; left: 0.9rem;
    background: var(--amber);
    color: var(--white);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }
  .card-body { padding: 1.4rem; flex: 1; display: flex; flex-direction: column; }
  .card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .card-title-row h3 { margin: 0; font-size: 1.18rem; }
  .card-price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--amber-deep);
    white-space: nowrap;
    text-align: right;
  }
  .card-price small { font-size: 0.72rem; color: var(--muted); font-weight: 500; }
  .card-body p { margin: 0; color: var(--muted); font-size: 0.96rem; }

  /* Order controls on the card */
  .card-order {
    margin-top: auto;
    padding-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: flex-end;
    border-top: 1px solid rgba(58, 42, 30, 0.08);
  }
  .card-order .opt { display: flex; flex-direction: column; gap: 0.25rem; flex: 1 1 auto; }
  .card-order .opt-qty { flex: 0 0 5.2rem; }
  .card-order .opt-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card-order select {
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 0.45rem 0.5rem;
    border: 1px solid rgba(58, 42, 30, 0.2);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    width: 100%;
  }
  /* A chosen quantity should be obvious at a glance while scrolling */
  .card.has-qty { outline: 2px solid var(--olive); outline-offset: -2px; }
  .card.has-qty .card-order select[data-role='qty'] {
    border-color: var(--olive);
    background: var(--olive);
    color: #fff;
    font-weight: 700;
  }

  .menu-cta { margin-top: 3rem; }
  .menu-running-total {
    margin: 0 0 1rem;
    color: var(--crust-soft);
    font-size: 1rem;
  }
  .menu-running-total strong {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--amber-deep);
    margin-left: 0.3rem;
  }

  /* Clickable card areas */
  button.card-media {
    border: none;
    padding: 0;
    display: block;
    width: 100%;
    cursor: pointer;
    font: inherit;
  }
  .title-button {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .title-button:hover { color: var(--amber-deep); }
  .card-details-link {
    margin-top: 0.9rem;
    background: none;
    border: none;
    padding: 0;
    align-self: flex-start;
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--amber-deep);
    cursor: pointer;
  }
  .card-details-link:hover { text-decoration: underline; }

  /* Product detail popup */
  .modal { display: none; position: fixed; inset: 0; z-index: 100; }
  .modal.is-open { display: flex; align-items: center; justify-content: center; padding: 1.2rem; }
  .modal-backdrop { position: absolute; inset: 0; background: rgba(30, 20, 12, 0.6); }
  .modal-card {
    position: relative;
    background: var(--white);
    border-radius: var(--radius);
    max-width: 520px;
    width: 100%;
    max-height: 88vh;
    overflow-y: auto;
    padding: 1.6rem;
    box-shadow: var(--shadow);
  }
  .modal-close {
    position: absolute; top: 0.7rem; right: 0.9rem;
    background: none; border: none;
    font-size: 1.9rem; line-height: 1;
    color: var(--muted); cursor: pointer;
  }
  .modal-close:hover { color: var(--crust); }
  .modal-panel[hidden] { display: none; }
  .modal-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
    background: var(--cream-deep);
    margin-bottom: 1rem;
  }
  .modal-title { font-family: var(--font-display); font-size: 1.4rem; color: var(--crust); margin: 0 0 0.3rem; }
  .modal-price { font-family: var(--font-display); font-weight: 700; color: var(--amber-deep); margin: 0 0 0.9rem; }
  .modal-price small { font-size: 0.72rem; color: var(--muted); font-weight: 500; }
  .modal-about { color: var(--crust-soft); margin: 0 0 1.1rem; }
  .modal-facts { margin: 0 0 1.3rem; }
  .modal-facts dt {
    font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--amber-deep); font-weight: 700; margin-top: 0.8rem;
  }
  .modal-facts dd { margin: 0.2rem 0 0; color: var(--crust-soft); font-size: 0.95rem; }
  .modal-facts .soon { color: var(--muted); font-style: italic; }
  .modal-order { width: 100%; text-align: center; }
</style>

<script>
  const search = document.getElementById('menu-search');
  const cards = Array.from(document.querySelectorAll('#menu .card'));
  const noResults = document.getElementById('menu-no-results');

  // ---- Translate dropdown options -------------------------------------
  // <option> can only hold text, so <T> cannot be used inside one. Both
  // labels ride along as data attributes and are swapped on language change.
  const translatableOptions = Array.from(document.querySelectorAll('option[data-label-zh]'));
  function applyOptionLanguage() {
    const zh = document.documentElement.getAttribute('data-lang') === 'zh';
    translatableOptions.forEach((o) => {
      o.textContent = zh ? o.dataset.labelZh : o.dataset.label;
    });
  }
  applyOptionLanguage();
  new MutationObserver(applyOptionLanguage).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-lang'],
  });

  // ---- Product detail popup -------------------------------------------
  const modal = document.getElementById('product-modal');
  if (modal) {
    const panels = Array.from(modal.querySelectorAll('.modal-panel'));
    let lastFocused = null;

    function openDetail(id) {
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      const close = modal.querySelector('.modal-close');
      if (close) close.focus();
    }
    function closeDetail() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocused) lastFocused.focus();
    }

    document.querySelectorAll('[data-detail-for]').forEach((btn) =>
      btn.addEventListener('click', () => {
        lastFocused = btn;
        openDetail(btn.dataset.detailFor);
      })
    );
    modal.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeDetail));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) closeDetail();
    });
  }

  if (search) {
    search.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const match = !q || (card.dataset.search || '').includes(q);
        card.hidden = !match;
        if (match) visible++;
      });
      if (noResults) noResults.hidden = visible !== 0;
    });
  }
</script>
